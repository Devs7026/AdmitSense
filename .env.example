# AdmitSense Environment Configuration
# Copy this file to .env and insert your real credentials.
# Do NOT commit .env to version control.

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Configured model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Storage paths (defaults shown)
# ADMITSENSE_DB_PATH=data/admitsense.db
# ADMITSENSE_DOCS_DIR=data/documents
# ADMITSENSE_HOSPITALS_PATH=data/hospitals/synthetic_hospitals.json
# ADMITSENSE_PORT=8501
